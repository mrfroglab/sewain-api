# sewain-api lokal: salin ke .env (jangan commit yang asli). Daftar lengkap: deploy/.env.example dan README.
PORT=8080
DATABASE_URL=postgres://sewain:devpass@localhost:55491/sewain?sslmode=disable
# development | demo | staging | production. Produksi menolak DEMO_MODE, OTP demo/echo, SNAPSHOT_SCOPE=full, kunci kosong.
APP_ENV=development
# Login persona, eKYC/bayar simulasi, jam demo, seed otomatis (OTP_PROVIDER default demo, kode 123456)
DEMO_MODE=true
SNAPSHOT_SCOPE=scoped
MIGRATE_ON_START=true
UPLOAD_DIR=./data/uploads
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Lokal tanpa proxy: kosong. Metrics lokal di 127.0.0.1:9090
TRUSTED_PROXY_CIDRS=
METRICS_ADDR=127.0.0.1:9090
# development/demo: kunci kosong diganti kunci acak sementara (hilang saat restart)
OTP_PEPPER=
KYC_KEYS=
NIK_PEPPER=
MEDIA_SIGNING_KEY=
