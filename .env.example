# sewain-api — copy to .env (never commit the real one)
PORT=8080
DATABASE_URL=postgres://sewain:devpass@localhost:55491/sewain?sslmode=disable
# demo | development | production. DEMO_MODE=true is refused when APP_ENV=production.
APP_ENV=development
# Fixed OTP, simulated eKYC/payment, demo login & demo clock (prototype only)
DEMO_MODE=true
UPLOAD_DIR=./data/uploads
# Where the web app serves /img/* (used to hash bundled "foto contoh")
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
