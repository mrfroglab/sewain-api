# Salin ke /opt/stacks/apps/<stack>/backup.env lalu chmod 600. Jangan commit yang asli.

# Tujuan salinan di luar server (remote rclone). Kosong = hanya salinan lokal di /opt/stacks/backup/<stack>.
# Pakai remote bertipe "crypt" supaya dump (berisi nomor HP & data pengguna) terenkripsi sebelum diunggah.
# Contoh: BACKUP_REMOTE=gdrive-crypt:sewain
BACKUP_REMOTE=

# Notifikasi saat backup gagal. Isi salah satu:
#   ntfy:     https://ntfy.sh/<topik-rahasia>
#   Discord:  https://discord.com/api/webhooks/...
#   Slack:    https://hooks.slack.com/services/...
BACKUP_NOTIFY_URL=

# Dead-man's switch (mis. healthchecks.io): di-ping hanya kalau backup lengkap berhasil.
BACKUP_HEARTBEAT_URL=

KEEP_DAILY=7
KEEP_WEEKLY=4
