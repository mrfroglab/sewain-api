# sewain-api v2: semua variabel environment. Salin ke /opt/stacks/apps/<stack>/.env (chmod 600) dan isi.
# JANGAN commit nilai asli. Nilai di bawah kosong atau contoh dummy. Keterangan lengkap: README.md "Environment".
# Buat kunci: openssl rand -base64 32 (pepper, KYC), openssl rand -hex 32 (MEDIA_SIGNING_KEY), `api vapid gen` (VAPID).

# --- Inti ---
DB_PASSWORD=
DATABASE_URL=postgres://sewain:CHANGE_ME@sewain-db:5432/sewain?sslmode=disable
# development | demo | staging | production
APP_ENV=production
# Wajib false di produksi (ditolak saat start)
DEMO_MODE=false
PORT=8080
MIGRATE_ON_START=true
# scoped (wajib di produksi) | full (hanya DEMO_MODE)
SNAPSHOT_SCOPE=scoped
# offline (pilot) | simulated (demo saja) | gateway (Fase 8, belum ada)
PAYMENT_MODE=offline
WEB_ORIGIN=http://sewain-web:3000

# --- HTTP / ops ---
CORS_ORIGINS=https://sewain.example
# Default = CORS_ORIGINS. Origin aplikasi lain (mis. Capacitor) tambahkan di sini.
ALLOWED_ORIGINS=
# Subnet gateway-net (cek: docker network inspect gateway-net)
TRUSTED_PROXY_CIDRS=172.16.0.0/12
REQUEST_TIMEOUT=15s
LOG_LEVEL=info
# :9090 untuk Prometheus di jaringan internal; off = mati. Jangan dipublish lewat ports/Caddy.
METRICS_ADDR=127.0.0.1:9090
RETENTION_INTERVAL=1h

# --- Rate limit (kosong/0 = default; nilai tidak valid = gagal start) ---
# Default untuk NAT kampus: ratusan mahasiswa di balik satu IP Wi-Fi. Dihitung di memori PER INSTANCE
# (dengan N instance, batas efektif N kali lipat). Lihat docs/integration/ops.md §2.
# Global semua rute, per user yang masuk (tamu per IP): 1200/menit, burst 300
RATE_PUBLIC_PER_MIN=
RATE_PUBLIC_BURST=
# Aksi/mutasi per user: 120/menit, burst 40
RATE_WRITE_PER_MIN=
RATE_WRITE_BURST=
# Unggah foto/KYC per user: 30/menit, burst 10
RATE_UPLOAD_PER_MIN=
RATE_UPLOAD_BURST=
# OTP request/verify per IP: 60/menit, burst 20
RATE_AUTH_PER_MIN=
RATE_AUTH_BURST=
# demo-login (hanya DEMO_MODE) per IP: 600/menit, burst 100
RATE_DEMO_PER_MIN=
RATE_DEMO_BURST=

# --- Auth / OTP ---
# zenziva (produksi) | echo (staging) | demo (hanya DEMO_MODE)
OTP_PROVIDER=zenziva
OTP_PEPPER=
# Batas OTP di database (berlaku lintas instance). Kosong/0 = default.
# Per nomor per jam (default 5)
OTP_MAX_PER_PHONE_HOUR=
# Per IP per jam (default 200, NAT kampus)
OTP_MAX_PER_IP_HOUR=
# Plafon global kode terkirim per hari WIB (default 2000). Anti SMS/WA pumping: tiap OTP berbayar.
OTP_MAX_SENDS_PER_DAY=
SESSION_COOKIE_SECURE=true
# Token bearer di body + ?token= di WebSocket (demo multi-tab). Ditolak di produksi.
SESSION_BEARER_LOGIN=false
TERMS_VERSION=
PRIVACY_VERSION=
ZENZIVA_WA_URL=
ZENZIVA_SMS_URL=
ZENZIVA_USERKEY=
ZENZIVA_PASSKEY=
# body | basic | bearer | none
ZENZIVA_AUTH=body
# form | json
ZENZIVA_BODY=form
ZENZIVA_FIELD_USERKEY=userkey
ZENZIVA_FIELD_PASSKEY=passkey
ZENZIVA_FIELD_TO=to
ZENZIVA_FIELD_MESSAGE=message
# local (0812…) | 62 | e164
ZENZIVA_PHONE_FORMAT=local
# Wajib memuat {code}. Kosong = pesan bawaan.
ZENZIVA_MESSAGE=
ZENZIVA_SUCCESS_FIELD=
ZENZIVA_SUCCESS_VALUE=
# k=v;k2=v2
ZENZIVA_EXTRA=

# --- KYC ---
# v1:<base64 32 byte>[,v2:<…>]  — yang terakhir dipakai untuk data baru. Jangan hapus kunci lama yang masih dipakai.
KYC_KEYS=
# TIDAK BOLEH BERUBAH (aturan satu NIK satu akun + blacklist bergantung padanya)
NIK_PEPPER=

# --- Media ---
# local | s3 (Cloudflare R2)
MEDIA_BACKEND=local
UPLOAD_DIR=/data/uploads
MEDIA_SIGNING_KEY=
MEDIA_SIGNING_KEY_PREVIOUS=
# Hanya untuk MEDIA_BACKEND=s3 (alias R2_*):
S3_ENDPOINT=
R2_ACCOUNT_ID=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true
S3_PREFIX=
# Kredensial yang boleh menghapus (job retensi). Proses API memakainya hanya di runner retensi.
S3_RETENTION_ACCESS_KEY_ID=
S3_RETENTION_SECRET_ACCESS_KEY=

# --- Notifikasi ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@sewain.example
# none | smtp | resend | log
MAIL_PROVIDER=none
MAIL_FROM=
PUBLIC_URL=https://sewain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | tls | none
SMTP_SECURITY=starttls
RESEND_API_KEY=
NOTIFY_PREFS_PATH=/profil/notifikasi
